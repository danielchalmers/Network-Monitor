<Window x:Class="Network_Monitor.PingAddressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ping address"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FluentFontFamily}"
        FontSize="14"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">
	<StackPanel Width="320" Margin="12">
		<Label Content="_Address to ping:"
		       Padding="0,0,0,4"
		       Target="{Binding ElementName=AddressBox}" />

		<TextBox x:Name="AddressBox"
		         AutomationProperties.Name="Address to ping"
		         AutomationProperties.HelpText="{Binding Text, ElementName=MessageText}">
			<!--  Its own Cut, Copy, and Paste, since the menu WPF makes for a text box is a kind of menu of its own, which the styles in FluentTheme.xaml don't reach, so it would stay Windows' old light one. The commands give each item its shortcut, and gray it out when there's nothing to cut, copy, or paste.  -->
			<TextBox.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" />
					<MenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
					<MenuItem Header="_Paste" Command="ApplicationCommands.Paste" />
				</ContextMenu>
			</TextBox.ContextMenu>
		</TextBox>

		<!--  Says what can be typed, and why when something else was. Screen readers read it with the box, and out loud when it changes.  -->
		<TextBlock x:Name="MessageText"
		           Margin="0,6,0,0"
		           AutomationProperties.LiveSetting="Assertive"
		           Text="An IPv4 or IPv6 address, like 8.8.8.8 or 2001:4860:4860::8888."
		           TextWrapping="Wrap" />

		<!--  Enter is OK and Escape is Cancel, as in any dialog.  -->
		<StackPanel Margin="0,16,0,0"
		            HorizontalAlignment="Right"
		            Orientation="Horizontal">
			<Button MinWidth="75"
			        Content="OK"
			        IsDefault="True"
			        Click="ButtonOk_OnClick" />

			<Button MinWidth="75"
			        Margin="8,0,0,0"
			        Content="Cancel"
			        IsCancel="True" />
		</StackPanel>
	</StackPanel>
</Window>