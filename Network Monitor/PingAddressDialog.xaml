<Window x:Class="Network_Monitor.PingAddressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ping address"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">
	<StackPanel Width="320" Margin="12">
		<Label Content="_Address to ping:"
		       Padding="0,0,0,4"
		       Target="{Binding ElementName=AddressBox}" />

		<TextBox x:Name="AddressBox"
		         AutomationProperties.Name="Address to ping"
		         AutomationProperties.HelpText="{Binding Text, ElementName=MessageText}" />

		<!--  Says what can be typed, and why when something else was. Screen readers read it with the box, and out loud when it changes.  -->
		<TextBlock x:Name="MessageText"
		           Margin="0,6,0,0"
		           AutomationProperties.LiveSetting="Assertive"
		           Text="An IPv4 or IPv6 address, like 8.8.8.8 or 2001:4860:4860::8888."
		           TextWrapping="Wrap" />

		<!--  Enter is OK and Escape is Cancel, as in any dialog.  -->
		<StackPanel Margin="0,16,0,0"
		            HorizontalAlignment="Right"
		            Orientation="Horizontal">
			<Button MinWidth="75"
			        Content="OK"
			        IsDefault="True"
			        Click="ButtonOk_OnClick" />

			<Button MinWidth="75"
			        Margin="8,0,0,0"
			        Content="Cancel"
			        IsCancel="True" />
		</StackPanel>
	</StackPanel>
</Window>