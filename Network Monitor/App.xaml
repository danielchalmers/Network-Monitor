<Application x:Class="Network_Monitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Themes/FluentTheme.xaml" />
				<!--  ThemeService puts the palette for the theme in its place when the app starts, and whenever the theme changes.  -->
				<ResourceDictionary Source="Themes/LightPalette.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>