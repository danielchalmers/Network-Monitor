<UserControl x:Class="Network_Monitor.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Network_Monitor"
             mc:Ignorable="d"
             AutomationProperties.Name="{Binding Monitor.SpokenValue, RelativeSource={RelativeSource Self}}"
             AutomationProperties.HelpText="{Binding Monitor.Details, RelativeSource={RelativeSource Self}}">
	<!--  The long show duration keeps the live-updating sparkline and stats visible while the user watches them.  -->
	<Grid DataContext="{Binding Monitor, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
	      Background="Transparent"
	      ToolTipService.ShowDuration="60000"
	      ToolTipOpening="Row_ToolTipOpening">
		<Grid.ToolTip>
			<!--  Beside the widget rather than under the cursor, so it never covers the other readings.  -->
			<ToolTip Placement="Custom"
			         CustomPopupPlacementCallback="{x:Static local:MonitorView.PlaceBesideWidget}"
			         Opened="ToolTip_Opened">
				<StackPanel MinWidth="180">
					<!--  ~60s trend of the same rolling window the stats summarize, tinted to match the monitor's icon.  -->
					<local:Sparkline Height="36"
					                 Margin="0,2,0,6"
					                 Values="{Binding History}"
					                 MinimumTop="{Binding HistoryMinimumTop}"
					                 StrokeThickness="1.5">
						<local:Sparkline.Style>
							<Style TargetType="local:Sparkline">
								<Setter Property="Stroke" Value="{Binding TooltipBrush}" />
								<Style.Triggers>
									<!--  In high contrast, the theme's text color, like the text under it, since only its own colors are sure to be readable. It's the system's own brush, which WPF keeps up to date, as the graph draws with a frozen pen, and the palette's brushes for high contrast can't be frozen.  -->
									<DataTrigger Binding="{Binding IsHighContrast, Source={x:Static local:ThemeService.Instance}}" Value="True">
										<Setter Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</local:Sparkline.Style>
					</local:Sparkline>

					<TextBlock Text="{Binding Details}" />
				</StackPanel>
			</ToolTip>
		</Grid.ToolTip>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
			<ColumnDefinition Width="*" SharedSizeGroup="Value" />
		</Grid.ColumnDefinitions>

		<TextBlock Grid.Column="0"
		           Text="{Binding Icon}"
		           FontWeight="DemiBold"
		           TextAlignment="Center">
			<TextBlock.Style>
				<Style TargetType="TextBlock">
					<Setter Property="Foreground" Value="{Binding IconBrush}" />
					<Style.Triggers>
						<!--  In high contrast, the theme's text color, like the reading beside it, since only its own colors are sure to be readable.  -->
						<DataTrigger Binding="{Binding IsHighContrast, Source={x:Static local:ThemeService.Instance}}" Value="True">
							<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</TextBlock.Style>
		</TextBlock>

		<Viewbox Grid.Column="1"
		         StretchDirection="DownOnly"
		         Margin="1,0,1,0">
			<TextBlock Text="{Binding DisplayValue}" TextAlignment="Center">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Style.Triggers>
							<!--  Dim values that are older than expected so they aren't mistaken for live readings.  -->
							<DataTrigger Binding="{Binding IsStale}" Value="True">
								<Setter Property="Opacity" Value="0.55" />
							</DataTrigger>

							<!--  A high contrast theme has a color of its own for dimmed text, which is sure to be readable, where fading the text could make it too faint.  -->
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding IsStale}" Value="True" />
									<Condition Binding="{Binding IsHighContrast, Source={x:Static local:ThemeService.Instance}}" Value="True" />
								</MultiDataTrigger.Conditions>
								<Setter Property="Opacity" Value="1" />
								<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
							</MultiDataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</Viewbox>
	</Grid>
</UserControl>