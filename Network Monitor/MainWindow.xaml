<Window x:Class="Network_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:root="clr-namespace:Network_Monitor"
        xmlns:p="clr-namespace:Network_Monitor.Properties"
        xmlns:monitors="clr-namespace:Network_Monitor.Monitors"
        mc:Ignorable="d"
        Title="Network Monitor"
        Topmost="{Binding Topmost, Source={x:Static p:Settings.Default}, Mode=TwoWay}"
        ShowInTaskbar="{Binding ShowInTaskbar, Source={x:Static p:Settings.Default}, Mode=TwoWay}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Consolas"
        MouseDown="MainWindow_OnMouseDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        SourceInitialized="Window_SourceInitialized"
        LocationChanged="Window_LocationChanged"
        Closing="Window_Closing"
        MouseDoubleClick="Window_MouseDoubleClick">
	<Window.Resources>
		<root:EnumToBooleanConverter x:Key="EnumToBoolean" />
	</Window.Resources>
	<Window.Style>
		<Style TargetType="Window">
			<Setter Property="Foreground">
				<Setter.Value>
					<SolidColorBrush Color="#242424" />
				</Setter.Value>
			</Setter>

			<Style.Triggers>
				<DataTrigger Binding="{Binding IsDark, Source={x:Static root:ThemeService.Instance}}" Value="True">
					<DataTrigger.Setters>
						<Setter Property="Foreground">
							<Setter.Value>
								<SolidColorBrush Color="#FFFFFF" />
							</Setter.Value>
						</Setter>
					</DataTrigger.Setters>
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</Window.Style>
	<Window.ContextMenu>
		<ContextMenu>
			<!--  Shows which version is running, as in DesktopClock.  -->
			<MenuItem Header="{x:Static root:App.VersionText}"
			          HeaderStringFormat="Network Monitor {0}"
			          IsEnabled="False" />

			<Separator />

			<MenuItem Header="_Copy" Click="MenuItemCopy_OnClick" />

			<Separator />

			<MenuItem Header="Measure in _bits (Mbps)"
			          IsCheckable="True"
			          IsChecked="{Binding Bits, Source={x:Static p:Settings.Default}, Mode=TwoWay}" />

			<!--  Populated on open so it always reflects the adapters currently on the machine.  -->
			<MenuItem x:Name="AdapterMenuItem"
			          Header="Network _adapter"
			          SubmenuOpened="MenuItemAdapter_OnSubmenuOpened">
				<MenuItem Header="(loading)" />
			</MenuItem>

			<MenuItem Header="Always on _top"
			          IsCheckable="True"
			          IsChecked="{Binding Topmost, Source={x:Static p:Settings.Default}, Mode=TwoWay}" />

			<MenuItem Header="_Show in taskbar"
			          IsCheckable="True"
			          IsChecked="{Binding ShowInTaskbar, Source={x:Static p:Settings.Default}, Mode=TwoWay}" />

			<MenuItem Header="_Horizontal layout"
			          IsCheckable="True"
			          IsChecked="{Binding Horizontal, Source={x:Static p:Settings.Default}, Mode=TwoWay}" />

			<!--  Picking a theme is a choice rather than a toggle: the items set it on click and the binding only shows it, so clicking the checked one keeps it checked. They stay checkable so screen readers announce which one is.  -->
			<MenuItem Header="Th_eme">
				<MenuItem Header="_Auto"
				          IsCheckable="True"
				          Tag="{x:Static root:AppTheme.Auto}"
				          Click="MenuItemTheme_OnClick"
				          IsChecked="{Binding Theme, Source={x:Static p:Settings.Default}, Converter={StaticResource EnumToBoolean}, ConverterParameter=Auto, Mode=OneWay}" />

				<MenuItem Header="_Light"
				          IsCheckable="True"
				          Tag="{x:Static root:AppTheme.Light}"
				          Click="MenuItemTheme_OnClick"
				          IsChecked="{Binding Theme, Source={x:Static p:Settings.Default}, Converter={StaticResource EnumToBoolean}, ConverterParameter=Light, Mode=OneWay}" />

				<MenuItem Header="_Dark"
				          IsCheckable="True"
				          Tag="{x:Static root:AppTheme.Dark}"
				          Click="MenuItemTheme_OnClick"
				          IsChecked="{Binding Theme, Source={x:Static p:Settings.Default}, Converter={StaticResource EnumToBoolean}, ConverterParameter=Dark, Mode=OneWay}" />
			</MenuItem>

			<MenuItem>
				<MenuItem.Header>
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Size: " />

						<Slider Width="64"
						        Value="{Binding Size, Source={x:Static p:Settings.Default}, Mode=TwoWay}"
						        Minimum="32"
						        Maximum="320"
						        IsSnapToTickEnabled="True"
						        AutoToolTipPlacement="TopLeft" />
					</StackPanel>
				</MenuItem.Header>
			</MenuItem>

			<Separator />

			<MenuItem Header="Start with _PC"
			          IsCheckable="True"
			          IsChecked="{Binding RunOnStartup, Source={x:Static p:Settings.Default}, Mode=TwoWay}" />

			<MenuItem Header="Check for _updates" Click="MenuItemCheckForUpdates_OnClick" />

			<MenuItem Header="Give _feedback" Click="MenuItemGiveFeedback_OnClick" />

			<MenuItem Header="E_xit" Click="MenuItemExit_OnClick" />
		</ContextMenu>
	</Window.ContextMenu>

	<Grid Grid.IsSharedSizeScope="True">
		<Grid.Style>
			<Style TargetType="Grid">
				<Setter Property="Background">
					<Setter.Value>
						<SolidColorBrush Color="#F3F3F3" Opacity="0.90" />
					</Setter.Value>
				</Setter>

				<Style.Triggers>
					<DataTrigger Binding="{Binding IsDark, Source={x:Static root:ThemeService.Instance}}" Value="True">
						<DataTrigger.Setters>
							<Setter Property="Background">
								<Setter.Value>
									<SolidColorBrush Color="#202020" Opacity="0.90" />
								</Setter.Value>
							</Setter>
						</DataTrigger.Setters>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Grid.Style>

		<Grid.Resources>
			<Style TargetType="root:MonitorView">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="root:MonitorView">
							<Viewbox Width="{Binding Size, Source={x:Static p:Settings.Default}, Mode=OneWay}">
								<ContentPresenter />
							</Viewbox>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</Grid.Resources>

		<ItemsControl ItemsSource="{Binding Monitors}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel>
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Setter Property="Orientation" Value="Vertical" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding Horizontal, Source={x:Static p:Settings.Default}, Mode=OneWay}" Value="True">
										<Setter Property="Orientation" Value="Horizontal" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>
					</StackPanel>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<root:MonitorView Monitor="{Binding}" Width="{Binding ActualWidth, ElementName=DummyMonitor}" />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!--  Hidden dummy monitor to preserve width  -->
		<root:MonitorView Visibility="Hidden">
			<root:MonitorView.Monitor>
				<monitors:DummyMonitor />
			</root:MonitorView.Monitor>
		</root:MonitorView>
	</Grid>
</Window>