<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--  Windows 11's dark colors, from DesktopClock's DarkPalette.xaml.  -->

	<!--  The widget, a little see-through so the desktop shows through it.  -->
	<SolidColorBrush x:Key="WidgetBackgroundBrush"
	                 Opacity="0.90"
	                 Color="#202020" />
	<SolidColorBrush x:Key="WidgetTextBrush" Color="#FFFFFF" />

	<!--  The menu and the tooltips.  -->
	<SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
	<SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6" />
	<SolidColorBrush x:Key="MenuBackgroundBrush" Color="#2C2C2C" />
	<SolidColorBrush x:Key="MenuBorderBrush" Color="#383838" />
	<SolidColorBrush x:Key="SeparatorBrush" Color="#3F3F3F" />
	<SolidColorBrush x:Key="SliderTrackBrush" Color="#757575" />
	<SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="#454545" />

	<!--  An item under the pointer or the keyboard.  -->
	<SolidColorBrush x:Key="HoverBrush" Color="#383838" />
	<SolidColorBrush x:Key="OnHoverTextBrush" Color="#FFFFFF" />

	<!--  Windows' own blue, lightened for the dark theme, for Light and Dark. In Auto, ThemeService puts the system accent over it.  -->
	<SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
</ResourceDictionary>