<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <runtime>
        <!--Lets WPF draw the widget again at a new scale when it moves to a monitor with a different one, along with the per-monitor setting in app.manifest. App sets it too, since the download is just the exe, without this file-->
        <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
    </runtime>
</configuration>