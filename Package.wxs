<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="Network Monitor" Manufacturer="Daniel Chalmers" Version="!(bind.FileVersion.NetworkMonitor.exe)" UpgradeCode="46A5208D-49CB-499A-BC21-7B6993B1F3F4" Scope="perUser">

    <Icon Id="NetworkMonitor.ico" SourceFile="Network Monitor\Network Monitor.ico" />

    <Property Id="ARPPRODUCTICON" Value="NetworkMonitor.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/danielchalmers/Network-Monitor" />
    <Property Id="ARPHELPLINK" Value="https://github.com/danielchalmers/Network-Monitor/issues" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--Skips the System Restore point, which can hold a double-click install at "Please wait" for most of a minute and protects nothing in a per-user app folder-->
    <Property Id="MSIFASTINSTALL" Value="1" />

    <!--The default schedule removes the old version before installing the new one, which a per-user upgrade needs to roll back cleanly. Same-version upgrades let one 0.0.0 build replace another-->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="!(loc.WixDowngradePreventedMessage)" />

    <MediaTemplate EmbedCab="yes" />

    <!--Not WiX's default INSTALLFOLDER under Programs: the settings are stored under a hash of the exe's path, so moving the app would lose them-->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Network Monitor" />
    </StandardDirectory>

    <File Id="NetworkMonitor.exe" Source="publish\$(sys.BUILDARCH)\Network Monitor.exe" />

    <!--Start menu shortcut, which needs a registry key path in a per-user install. Its target is the folder path rather than [#NetworkMonitor.exe], which ICE69 flags because the exe is in another component. Its component also removes the install folder once it's empty-->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component>
        <Shortcut Name="Network Monitor" Target="[INSTALLFOLDER]Network Monitor.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Daniel Chalmers\Network Monitor" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
    </StandardDirectory>

    <!--Starts the widget after installing or upgrading, but not when installing silently. Started through Explorer so the widget gets the user's environment instead of the Windows Installer service's-->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[#NetworkMonitor.exe]&quot;" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed AND UILevel &gt; 2" />
    </InstallExecuteSequence>
  </Package>
</Wix>
